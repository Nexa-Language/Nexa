{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Dependency": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "digest": {
          "minLength": 1,
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "name",
        "digest"
      ],
      "title": "Dependency",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "requirement": {
          "title": "Requirement",
          "type": "string"
        },
        "kind": {
          "enum": [
            "deterministic",
            "model_review",
            "human_decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "subject_digest": {
          "title": "Subject Digest",
          "type": "string"
        },
        "policy_digest": {
          "title": "Policy Digest",
          "type": "string"
        },
        "checker_digest": {
          "title": "Checker Digest",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "issued_at": {
          "minimum": 0,
          "title": "Issued At",
          "type": "number"
        },
        "expires_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "model_pinned": {
          "default": true,
          "title": "Model Pinned",
          "type": "boolean"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "artifact_digests": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Artifact Digests",
          "type": "array"
        }
      },
      "required": [
        "requirement",
        "kind",
        "subject_digest",
        "policy_digest",
        "checker_digest",
        "dependencies",
        "passed",
        "issued_at",
        "task_id"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "FileChange": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "before_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before Digest"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Content"
        }
      },
      "required": [
        "path",
        "before_digest",
        "content"
      ],
      "title": "FileChange",
      "type": "object"
    },
    "SnapshotFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Content"
        },
        "mode": {
          "default": 420,
          "title": "Mode",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "content"
      ],
      "title": "SnapshotFile",
      "type": "object"
    },
    "WorkspaceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "root": {
          "title": "Root",
          "type": "string"
        },
        "device": {
          "title": "Device",
          "type": "integer"
        },
        "inode": {
          "title": "Inode",
          "type": "integer"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/SnapshotFile"
          },
          "title": "Files",
          "type": "array"
        }
      },
      "required": [
        "root",
        "device",
        "inode",
        "files"
      ],
      "title": "WorkspaceSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "baseline": {
      "$ref": "#/$defs/WorkspaceSnapshot"
    },
    "candidate_digest": {
      "title": "Candidate Digest",
      "type": "string"
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/FileChange"
      },
      "title": "Changes",
      "type": "array"
    },
    "policy_digest": {
      "title": "Policy Digest",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "title": "Evidence",
      "type": "array"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "diff": {
      "title": "Diff",
      "type": "string"
    }
  },
  "required": [
    "baseline",
    "candidate_digest",
    "changes",
    "policy_digest",
    "evidence",
    "task_id",
    "diff"
  ],
  "title": "PatchProposal",
  "type": "object"
}
