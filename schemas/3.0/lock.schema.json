{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "compiler_version": {
      "const": "3.0.reference.1",
      "default": "3.0.reference.1",
      "title": "Compiler Version",
      "type": "string"
    },
    "program_digest": {
      "title": "Program Digest",
      "type": "string"
    },
    "environment_digest": {
      "title": "Environment Digest",
      "type": "string"
    },
    "artifact_digest": {
      "title": "Artifact Digest",
      "type": "string"
    }
  },
  "required": [
    "program_digest",
    "environment_digest",
    "artifact_digest"
  ],
  "title": "BuildLock",
  "type": "object"
}
