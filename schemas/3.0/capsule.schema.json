{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AcceptancePolicy": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/Requirement"
          },
          "title": "Requirements",
          "type": "array"
        }
      },
      "required": [
        "name",
        "requirements"
      ],
      "title": "AcceptancePolicy",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "goal_digest": {
          "title": "Goal Digest",
          "type": "string"
        },
        "implementation": {
          "$ref": "#/$defs/Implementation"
        },
        "capabilities": {
          "default": [],
          "items": {
            "enum": [
              "repo.read",
              "sandbox.exec",
              "sandbox.write",
              "model.call"
            ],
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "origin": {
          "default": "author",
          "title": "Origin",
          "type": "string"
        },
        "dependencies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "title": "Dependencies",
          "type": "array"
        }
      },
      "required": [
        "goal_digest",
        "implementation"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CapsuleOrigin": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "creator": {
          "minLength": 1,
          "title": "Creator",
          "type": "string"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        }
      },
      "required": [
        "source",
        "creator",
        "license"
      ],
      "title": "CapsuleOrigin",
      "type": "object"
    },
    "Dependency": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "digest": {
          "minLength": 1,
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "name",
        "digest"
      ],
      "title": "Dependency",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "requirement": {
          "title": "Requirement",
          "type": "string"
        },
        "kind": {
          "enum": [
            "deterministic",
            "model_review",
            "human_decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "subject_digest": {
          "title": "Subject Digest",
          "type": "string"
        },
        "policy_digest": {
          "title": "Policy Digest",
          "type": "string"
        },
        "checker_digest": {
          "title": "Checker Digest",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "issued_at": {
          "minimum": 0,
          "title": "Issued At",
          "type": "number"
        },
        "expires_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "model_pinned": {
          "default": true,
          "title": "Model Pinned",
          "type": "boolean"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "artifact_digests": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Artifact Digests",
          "type": "array"
        }
      },
      "required": [
        "requirement",
        "kind",
        "subject_digest",
        "policy_digest",
        "checker_digest",
        "dependencies",
        "passed",
        "issued_at",
        "task_id"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "GoalSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Parameter"
          },
          "title": "Parameters",
          "type": "array"
        },
        "return_type": {
          "enum": [
            "Int",
            "Float",
            "String",
            "Bool",
            "Json",
            "Unit",
            "Patch",
            "Repository",
            "ChangeRequest"
          ],
          "title": "Return Type",
          "type": "string"
        },
        "intent": {
          "minLength": 1,
          "title": "Intent",
          "type": "string"
        },
        "stage": {
          "default": "build",
          "enum": [
            "build",
            "runtime"
          ],
          "title": "Stage",
          "type": "string"
        },
        "context": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Context",
          "type": "array"
        },
        "capabilities": {
          "default": [],
          "items": {
            "enum": [
              "repo.read",
              "sandbox.exec",
              "sandbox.write",
              "model.call"
            ],
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "checks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Checks",
          "type": "array"
        },
        "reviews": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reviews",
          "type": "array"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "implementation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Implementation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "span": {
          "$ref": "#/$defs/SourceSpan",
          "default": {
            "path": "<source>",
            "line": 1,
            "column": 1,
            "end_line": 1,
            "end_column": 1
          }
        }
      },
      "required": [
        "name",
        "return_type",
        "intent"
      ],
      "title": "GoalSpec",
      "type": "object"
    },
    "Implementation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "value",
            "python"
          ],
          "title": "Kind",
          "type": "string"
        },
        "body": {
          "title": "Body",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "body"
      ],
      "title": "Implementation",
      "type": "object"
    },
    "Parameter": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "Int",
            "Float",
            "String",
            "Bool",
            "Json",
            "Unit",
            "Patch",
            "Repository",
            "ChangeRequest"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "Parameter",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "deterministic",
            "model_review",
            "human_decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "checker_digest": {
          "minLength": 1,
          "title": "Checker Digest",
          "type": "string"
        },
        "dependencies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        }
      },
      "required": [
        "name",
        "kind",
        "checker_digest"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "default": "<source>",
          "title": "Path",
          "type": "string"
        },
        "line": {
          "default": 1,
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "column": {
          "default": 1,
          "minimum": 1,
          "title": "Column",
          "type": "integer"
        },
        "end_line": {
          "default": 1,
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "end_column": {
          "default": 1,
          "minimum": 1,
          "title": "End Column",
          "type": "integer"
        }
      },
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "language_version": {
      "const": "3.0",
      "default": "3.0",
      "title": "Language Version",
      "type": "string"
    },
    "goal": {
      "$ref": "#/$defs/GoalSpec"
    },
    "candidate": {
      "$ref": "#/$defs/Candidate"
    },
    "conditions": {
      "items": {
        "$ref": "#/$defs/Dependency"
      },
      "title": "Conditions",
      "type": "array"
    },
    "origin": {
      "$ref": "#/$defs/CapsuleOrigin"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "title": "Evidence",
      "type": "array"
    },
    "policy": {
      "$ref": "#/$defs/AcceptancePolicy"
    }
  },
  "required": [
    "goal",
    "candidate",
    "conditions",
    "origin",
    "evidence",
    "policy"
  ],
  "title": "ImplementationCapsule",
  "type": "object"
}
