// Read tools are workspace-bound. Writes and commands pause for explicit approval.
@tool("Read a UTF-8 file inside the current workspace")
fn read_file(path: string): string {
    python! """
from src.runtime.workspace_tools import read_file
return read_file(path)
"""
}

@tool("Atomically write a file inside the current workspace", requires_approval: true, risk_level: "high")
fn write_file(path: string, content: string): string {
    python! """
from src.runtime.workspace_tools import write_file
return write_file(path, content)
"""
}

@tool("Search text in workspace files")
fn search_files(pattern: string, directory: string): string {
    python! """
from src.runtime.workspace_tools import search_files
return search_files(pattern, directory)
"""
}

@tool("List a directory inside the current workspace")
fn list_directory(path: string): string {
    python! """
from src.runtime.workspace_tools import list_directory
return list_directory(path)
"""
}

@tool("Execute an approved command in the workspace; this tool has no OS sandbox", requires_approval: true, risk_level: "high")
fn shell_exec(command: string): string {
    python! """
from src.runtime.workspace_tools import shell_exec
return shell_exec(command)
"""
}
